---
import type { Term } from "../../data/terms";

interface Props {
  term: Term;
  parent?: Term;
}

const { term, parent } = Astro.props;

const levelLabel = {
  family: "家族 Family",
  group: "子群 Group",
  type: "类型 Type",
}[term.level];
---

<header class="term-header">
  <p class="badges">
    <span class="badge accent">{levelLabel}</span>
    {term.grades && <span class="badge">{term.grades}</span>}
    <span class="badge">WHO CNS5</span>
  </p>
  <h1>{term.en}</h1>
  <p class="zh">{term.zh}</p>
  {parent && (
    <p class="parent">
      上级家族：<a href={`/types/${parent.slug}/`}>{parent.en}</a>（{parent.zh}）
    </p>
  )}
  <p class="summary">{term.summary}</p>
</header>

<style>
  .term-header {
    margin-bottom: 2rem;
  }
  .badges {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin: 0 0 0.8rem;
  }
  .badge {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    border: 1px solid var(--line);
    border-radius: 99px;
    padding: 0.15rem 0.7rem;
    color: var(--muted);
  }
  .badge.accent {
    background: var(--accent-soft);
    border-color: transparent;
    color: var(--accent);
    font-weight: 700;
  }
  h1 {
    font-size: clamp(1.5rem, 4vw, 2.2rem);
    line-height: 1.25;
    margin: 0 0 0.3rem;
  }
  .zh {
    color: var(--muted);
    font-size: 1.1rem;
    margin: 0 0 0.4rem;
  }
  .parent {
    font-size: 0.9rem;
    color: var(--muted);
    margin: 0.2rem 0;
  }
  .summary {
    border-left: 3px solid var(--accent);
    padding: 0.4rem 0.9rem;
    background: var(--surface);
    border-radius: 0 10px 10px 0;
    margin-top: 1rem;
  }
</style>
