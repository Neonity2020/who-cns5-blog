---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import TermHeader from "../../components/types/TermHeader.astro";
import TermSection from "../../components/types/TermSection.astro";
import RelatedTerms from "../../components/types/RelatedTerms.astro";
import { terms, type Term } from "../../data/terms";

export function getStaticPaths() {
  return terms.map((term) => ({ params: { slug: term.slug }, props: { term } }));
}

const { term } = Astro.props as { term: Term };
const parent = term.parent ? terms.find((t) => t.slug === term.parent) : undefined;
const related = term.related
  .map((r) => ({ ...r, term: r.slug ? terms.find((t) => t.slug === r.slug) : undefined }))
  .filter((r) => r.term);

const breadcrumbs = [
  { label: "← 首页", href: "/" },
  { label: "词条系统", href: "/types/" },
  { label: term.en },
];
---

<BaseLayout
  title={`${term.en} · ${term.zh} | WHO CNS5 词条`}
  description={term.summary}
>
  <Breadcrumbs slot="nav" items={breadcrumbs} maxWidth="820px" />

  <main>
    <TermHeader term={term} parent={parent} />

    {term.sections.map((sec) => (
      <TermSection section={sec} />
    ))}

    <RelatedTerms items={related} />
  </main>
</BaseLayout>

<style>
  main {
    max-width: 820px;
    margin: 0 auto;
    padding: 1.5rem 1.5rem 3rem;
  }
</style>
