---
import AiSidebar from '../../components/AiSidebar.astro';
import { terms, type Term } from "../../data/terms";

export function getStaticPaths() {
  return terms.map((term) => ({ params: { slug: term.slug }, props: { term } }));
}

const { term } = Astro.props as { term: Term };
const parent = term.parent ? terms.find((t) => t.slug === term.parent) : undefined;
const related = term.related
  .map((r) => ({ ...r, term: r.slug ? terms.find((t) => t.slug === r.slug) : undefined }))
  .filter((r) => r.term);

// 极简 **加粗** 与 [文字](/types/slug/) 站内链接（内容均为本站自有，安全）
const md = (s: string) =>
  s
    .replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>")
    .replace(/\[([^\]]+)\]\((\/types\/[a-z0-9-]+\/?)\)/g, '<a href="$2">$1</a>');
const levelLabel = { family: "家族 Family", group: "子群 Group", type: "类型 Type" }[term.level];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{term.en} · {term.zh} | WHO CNS5 词条</title>
    <meta name="description" content={term.summary} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <nav class="crumbs">
      <a href="/">← 首页</a>
      <span>/</span>
      <a href="/types/">词条系统</a>
      <span>/</span>
      <span class="here">{term.en}</span>
    </nav>

    <main>
      <header>
        <p class="badges">
          <span class="badge accent">{levelLabel}</span>
          {term.grades && <span class="badge">{term.grades}</span>}
          <span class="badge">WHO CNS5</span>
        </p>
        <h1>{term.en}</h1>
        <p class="zh">{term.zh}</p>
        {parent && (
          <p class="parent">
            上级家族：<a href={`/types/${parent.slug}/`}>{parent.en}</a>（{parent.zh}）
          </p>
        )}
        <p class="summary">{term.summary}</p>
      </header>

      {term.sections.map((sec) => (
        <section>
          <h2>{sec.heading}</h2>
          {sec.body && sec.body.map((p) => <p set:html={md(p)} />)}
          {sec.table && (
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>{sec.table.head.map((h) => <th>{h}</th>)}</tr>
                </thead>
                <tbody>
                  {sec.table.rows.map((row) => (
                    <tr>{row.map((cell) => <td set:html={md(cell)} />)}</tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </section>
      ))}

      {related.length > 0 && (
        <section>
          <h2>相关词条</h2>
          <ul class="related">
            {related.map((r) => (
              <li>
                <a href={`/types/${r.slug}/`}>{r.label}</a>
                <span class="zh-inline">{r.term?.zh}</span>
              </li>
            ))}
          </ul>
        </section>
      )}
    </main>

    <footer>
      <p class="brand">「认知凤凰社」出品</p>
      <p>
        内容与 mri-wiki-cn 知识库词条同源；重构自
        <a href="https://radiopaedia.org/articles/who-classification-of-cns-tumours-1?lang=us" target="_blank" rel="noopener">Radiopaedia《WHO classification of CNS tumors》</a>
        （CC BY-NC-SA）。仅供学习交流。
      </p>
    </footer>

    <style>
      :root {
        --bg: #faf9f7; --surface: #fff; --ink: #1f2933; --muted: #5f6b76;
        --accent: #0f766e; --accent-soft: #ccfbf1; --line: #e4e2dd;
        --mono: ui-monospace, "SF Mono", Menlo, monospace;
      }
      @media (prefers-color-scheme: dark) {
        :root { --bg:#14181c; --surface:#1c2127; --ink:#e7ebef; --muted:#9aa7b1; --accent:#2dd4bf; --accent-soft:#0f3d38; --line:#2c333b; }
      }
      * { box-sizing: border-box; }
      body { margin:0; background:var(--bg); color:var(--ink);
        font:16px/1.8 system-ui,-apple-system,"PingFang SC","Noto Sans SC","Microsoft YaHei",sans-serif; }
      a { color:var(--accent); text-decoration:none; }
      a:hover { text-decoration:none; }
      a:focus-visible { outline:2px solid var(--accent); outline-offset:2px; border-radius:4px; }
      p a, td a, li a, .layer-desc a, .summary a {
        text-decoration:underline; text-decoration-thickness:1px;
        text-decoration-color:transparent; text-underline-offset:3px;
        transition:color .15s ease, text-decoration-color .15s ease;
      }
      p a:hover, td a:hover, li a:hover, .layer-desc a:hover, .summary a:hover {
        text-decoration-color:currentColor;
      }

      .crumbs { max-width:820px; margin:0 auto; padding:1.2rem 1.5rem 0;
        font-size:.85rem; color:var(--muted); display:flex; gap:.5rem; align-items:center; }
      .crumbs a { color:var(--muted); transition:color .15s ease; }
      .crumbs a:hover { color:var(--accent); }
      .crumbs .here { color:var(--ink); font-family:var(--mono); font-size:.8rem; }

      main { max-width:820px; margin:0 auto; padding:1.5rem 1.5rem 3rem; }
      header { margin-bottom:2rem; }
      .badges { display:flex; gap:.5rem; flex-wrap:wrap; margin:0 0 .8rem; }
      .badge { font-family:var(--mono); font-size:.72rem; letter-spacing:.06em;
        border:1px solid var(--line); border-radius:99px; padding:.15rem .7rem; color:var(--muted); }
      .badge.accent { background:var(--accent-soft); border-color:transparent; color:var(--accent); font-weight:700; }
      h1 { font-size:clamp(1.5rem,4vw,2.2rem); line-height:1.25; margin:0 0 .3rem; }
      .zh { color:var(--muted); font-size:1.1rem; margin:0 0 .4rem; }
      .parent { font-size:.9rem; color:var(--muted); margin:.2rem 0; }
      .summary { border-left:3px solid var(--accent); padding:.4rem .9rem; background:var(--surface);
        border-radius:0 10px 10px 0; margin-top:1rem; }

      section { margin:0 0 2.4rem; }
      h2 { font-size:1.2rem; margin:0 0 .8rem; padding-bottom:.4rem; border-bottom:1px solid var(--line); }
      p { margin:.5rem 0; }

      .table-wrap { overflow-x:auto; background:var(--surface); border:1px solid var(--line); border-radius:10px; }
      table { width:100%; border-collapse:collapse; font-size:.92rem; }
      th, td { padding:.55rem .85rem; border-bottom:1px solid var(--line); text-align:left; vertical-align:top; }
      th { background:var(--accent-soft); font-weight:600; white-space:nowrap; }
      tr:last-child td { border-bottom:none; }

      .related { list-style:none; padding:0; margin:0; display:flex; flex-wrap:wrap; gap:.6rem; }
      .related li { margin:0; display:flex; align-items:center; gap:.5rem; }
      .related a {
        display:inline-flex; align-items:center; gap:.45rem;
        border:1px solid var(--line); border-radius:99px; background:var(--surface);
        padding:.32rem .95rem; font-family:var(--mono); font-size:.85rem; color:var(--ink);
        transition:border-color .18s ease, background .18s ease, color .18s ease;
      }
      .related a::after { content:"→"; color:var(--muted);
        transition:transform .18s ease, color .18s ease; }
      .related a:hover { border-color:var(--accent); background:var(--accent-soft); color:var(--accent); }
      .related a:hover::after { transform:translateX(3px); color:var(--accent); }
      .zh-inline { color:var(--muted); font-size:.82rem; }

      footer { border-top:1px solid var(--line); padding:1.4rem; text-align:center;
        color:var(--muted); font-size:.8rem; max-width:820px; margin:0 auto; }
      .brand { font-weight:700; letter-spacing:.08em; color:var(--ink); margin:0 0 .4rem; font-size:.95rem; }
    </style>
    <AiSidebar />
  </body>
</html>
